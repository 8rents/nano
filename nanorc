## system nanorc files
## ~~~~~~~~~~~~~~~~~~~~
## Must be absolute links. In the order they are loaded:

# 1. System-wide configuration file.
#    - /etc/nanorc
# 2. Per-user configuration files (1 of the 3)
#    - ~/.nanorc
#    - $XDG_CONFIG_HOME/nano/nanorc
#    -  ~/.config/nano/nanorc

# Syntax definitions for the syntax coloring
# note: less common languages in extras & custom user in
#    - /usr/share/nano/*.nanorc
#    - /usr/share/nano/extra/*.nanorc
#    - ./lib/nano-syntax-highlighting/*.nanorc

include /data/data/com.termux/files/usr/share/nano/*.nanorc
include /data/data/com.termux/files/usr/share/nano/extra/*.nanorc


## Interface Settings
## ------------------

# allow_insecure_backup - When backing up files, allow the backup to succeed even if its permissions can't be (re)set due to special OS considerations. You should NOT enable this option unless you are sure you need it.
unset allow_insecure_backup

# backup - When saving a file, create a backup file by adding a tilde (~) to the file's name.
unset backup

# backupdir - Set the directory where nano puts unique backup files. Only if file backups are enabled
# set backupdir "backups"

# guidestripe - Draw a vertical stripe at the given column, to help judge the width of the text. (The color of the stripe can be changed with 'set stripecolor'
# set guidestripe 80

# indicator - Display a "scrollbar" on the right-hand side
set indicator

# linenumbers - Show line numbers
set linenumbers

# minibar - Suppress titlebar,instead Show minibar on bottom
set minibar

# nohelp - Hide help on bottom
set nohelp

# positionlog - Display the cursor position row,col in the status bar
set positionlog

# quickblank - Do quick statusbar blanking. Statusbar messages will disappear after 1 keystroke instead of 25
unset quickblank

# constantshow - Constantly display the cursor position and line number on the statusbar/minibar as x,y at column 50
set constantshow

# stateflags - Use the top-right corner of the screen for showing some state flags:
# - I when auto-indenting
# - M when the mark is on
# - L when hard-wrapping (breaking long lines)
# - R when recording a macro
# - S when soft-wrapping
# - * is shown when the buffer has been modified
set stateflags

# mouse - Enable mouse support, When enabled, mouse clicks can be used to place the cursor, set the mark (with a double click),
set mouse

# Log search and replace strings to ~/.nano_history
set historylog

# Enable multiple file buffers
set multibuffer

# * morespace - Use blank line below title bar for editing
# unset morespace

# * smooth - Use smooth scrolling. Line by line, not chunks
# set smooth

# * nofollow - Don't follow symlinks when writing files
# unset nofollow

# zero - Hide all elements of the interface (title bar, status bar, and help lines) and use all rows of the terminal for showing the contents of the buffer. The status bar appears only when there is a significant message, and disappears after 1.5 seconds or upon the next keystroke. With alt+Z the title bar plus status bar can be toggled. With alt+X the help lines.
unset zero

## Editor Settings
## ---------------

# atblanks - When soft line wrapping is enabled, make it wrap lines at blank characters (tabs and spaces) instead of always at the edge of the screen.
set atblanks

# Use auto-indentation
set autoindent

# afterends - Make Ctrl+Right and Ctrl+Delete stop at word ends instead of beginnings
set afterends

# autoindent - Automatically indent a newly created line to the same number of tabs and/or spaces as the previous line (or as the next line if the previous line is the beginning of a paragraph
set autoindent

# backup - When writing a file, creates a backup of the current file
unset backup

# backupdir - Make and keep not just one backup file, but make and keep a uniquely numbered one every time a file is saved — when backups are enabled with set backup or --backup or -B. The uniquely numbered files are stored in the specified directory.
# set backupdir "./backup"

# showcursor - Put the cursor on the highlighted item in the file browser, and show the cursor in the help viewer, to aid braille users and people with poor vision
set showcursor

# smarthome - Make the Home key smarter. When Home is pressed anywhere but at the very beginning of non-whitespace characters on a line, the cursor jumps to that beginning (either forwards or backwards). If the cursor is already at that position, it jumps to the true beginning of the line.
set smarthome

# softwrap - Display lines that exceed the screen's width over multiple screen lines. (You can make this soft-wrapping occur at whitespace instead of rudely at the screen's edge, by using also set atblanks.)
set softwrap

# * solosidescroll - When the cursor approaches the right edge of the edit window, scroll only the current line sideways by a large amount, instead of scrolling all visible lines sideways by just the amount needed to keep the cursor in view. This latter whole-window smooth sideways scrolling is the new default behavior. The single-line jerky sideways scrolling enabled by this option was the old behavior — the only behavior that nano knew.
# set solosidescroll

# speller - Use the given program to do spell checking and correcting, instead of using the built-in corrector that calls hunspell(1) or spell(1).
set speller "aspell -x -c"

# stateflags - Use the top-right corner of the screen for showing some state flags: I when auto-indenting, M when the mark is on, L when hard-wrapping (breaking long lines), R when recording a macro, and S when soft-wrapping. When the buffer is modified, a star (*) is shown after the filename in the center of the title bar.
set stateflags

# tabsize - Use a tab size of number columns. The value of number must be greater than 0. The default value is 8.
set tabsize 4

# tabstospaces - Convert each typed tab to spaces — to the number of spaces that a tab at that position would take up. (Note: pasted tabs are not converted.)
unset tabstospaces

# trimblanks - Remove trailing whitespace from wrapped lines when automatic hard-wrapping occurs or when text is justified.
set trimblanks

# set unix - Save a file by default in Unix format. This overrides nano's default behavior of saving a file in the format that it had. (This option has no effect when you also use set noconvert.)
unset unix

# whitespace "characters" - Set the two characters used to indicate the presence of tabs and spaces. They must be single-column characters. The default pair for a UTF-8 locale is "»⋅", and for other locales ">.".

# wordchars "characters" - Specify which other characters (besides the normal alphanumeric ones) should be considered as parts of words. When using this option, you probably want to unset wordbounds.
set wordchars "'"

# Remove blank lines at end of file
set trimblanks

# Don't add newlines to the ends of files
set nonewlines

# Make the 'Cut Text' command (normally ^K) cut from the cur rent cursor position to the end of  the  line,  instead  of cutting the entire line
set cutfromcursor

# Detect word boundaries more accurately by treating punctuation characters as part of a word
set wordbounds

# Let  an  unmodified  Backspace  or  Delete erase the marked region (instead of a single character, and without  affecting the cutbuffer)
set zap

# Do case sensitive searches by default
unset casesensitive

# Don't add newlines to the ends of files
set nonewlines

# Don't convert files from DOS/Mac format
unset noconvert


